<!-- @implements PackageInputs, QualityChecks -->
<Project>
  <Target Name="ValidateXcmdBuildProfile" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="'$(Configuration)' != 'Release' Or '$(RuntimeIdentifier)' != 'win-x64' Or '$(PlatformTarget)' != 'x64'"
           Text="Xcmd supports only Release / win-x64 / x64. Use the repository build defaults." />
    <Error Condition="'$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifiers)' != 'win-x64'"
           Text="Xcmd supports only the win-x64 runtime. Do not restore other runtime targets." />
  </Target>
</Project>
