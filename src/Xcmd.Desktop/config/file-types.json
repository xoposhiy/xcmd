{
  "rules": [
    {
      "name": "source",
      "color": "#C3ABF5",
      "extensions": [".cs", ".fs", ".vb", ".c", ".h", ".cpp", ".hpp", ".cc", ".cxx", ".go", ".rs", ".py", ".pyw", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".java", ".kt", ".kts", ".scala", ".swift", ".rb", ".php", ".pl", ".lua", ".r", ".sql", ".sh", ".bash", ".zsh", ".fish", ".ps1", ".psm1", ".psd1", ".cmd", ".bat", ".html", ".htm", ".css", ".scss", ".sass", ".less", ".vue", ".svelte", ".xaml", ".axaml"],
      "fileNames": ["Dockerfile", "Containerfile", "Makefile", "GNUmakefile", "CMakeLists.txt", "Justfile", "Rakefile"]
    },
    {
      "name": "executable",
      "color": "#E9BD79",
      "extensions": [".exe", ".com", ".msi", ".msix", ".appx", ".scr", ".cmd", ".bat", ".sh", ".ps1"],
      "fileNames": []
    },
    {
      "name": "text",
      "color": "#8DD3E8",
      "extensions": [".txt", ".md", ".markdown", ".rst", ".log", ".csv", ".tsv", ".json", ".jsonl", ".xml", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".config", ".properties", ".editorconfig", ".gitignore", ".gitattributes", ".env", ".sln", ".slnx", ".csproj", ".fsproj", ".props", ".targets"],
      "fileNames": ["README", "LICENSE", "NOTICE", "CHANGELOG", ".gitignore", ".gitattributes", ".editorconfig", ".env"]
    }
  ]
}
