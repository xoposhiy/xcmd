<!-- @implements PackageInputs -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XcmdLauncher)' == 'true'">
    <OutputType>WinExe</OutputType>
    <AssemblyName>Xcmd</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <ApplicationIcon>../Xcmd.Desktop/Assets/app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(XcmdLauncher)' != 'true'">
    <ProjectReference Include="../Xcmd.Core/Xcmd.Core.csproj" />
    <Content Include="claude_sessions.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="claude_sessions.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Syntax/Grammars/*.json" LogicalName="Xcmd.Syntax.%(Filename).json" />
    <EmbeddedResource Include="SessionClassification/Instructions.txt" LogicalName="Xcmd.SessionClassification.Instructions" />
    <EmbeddedResource Include="../Xcmd.Desktop/config/session-api-prices.json" LogicalName="Xcmd.SessionApiPrices" />
    <Content Include="Syntax/Grammars/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(XcmdLauncher)' == 'true'">
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
    <Compile Include="BootstrapProgram.cs;ReleaseFiles.cs;WindowsShortcut.cs;ShellPropertyValues.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(XcmdLauncher)' != 'true'">
    <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="TextMateSharp" Version="2.0.5" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.5" />
  </ItemGroup>
</Project>
